rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // users/{uid} — profile doc, document ID is the owner's own Firebase Auth uid.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // businesses/{businessId} — ownerId field ties a business to its owner.
    // Covers the existing query pattern (`where("ownerId", "==", uid)`) used by
    // useBusinesses/sign-in redirect logic: every doc a matching query can
    // return already satisfies this rule.
    match /businesses/{businessId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
    }
  }
}
